# Frontend Environment Variables (.env.example)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PayPal Integration (Sandbox for development, live for production)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Backend API URLs
VITE_API_URL=http://localhost:5000/api
VITE_ADMIN_API_URL=http://localhost:5001

# Legacy Stripe (Kept for historical record viewing if needed)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
